---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCategoryPhotos, getCoverImage, getPhotoByPath } from '../lib/photos';
import site from '../content/site.json';

const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order);
const aboutPhoto = getPhotoByPath(site.aboutPhoto);
const heroPhoto = getPhotoByPath(site.heroPhoto);

// Добірка фото з різних категорій для мозаїки на головній (не лайтбокс — лише посилання на категорію).
// Фото, яке вже показане в hero, тут пропускаємо, щоб не дублювати.
const showcasePhotos = galleries.flatMap((gallery) => {
  const photos = getCategoryPhotos(gallery.data.slug, gallery.data.title, gallery.data.photos).filter(
    (photo) => photo.image.src !== heroPhoto?.src
  );
  return photos.slice(0, 3).map((photo) => ({ photo, slug: gallery.data.slug }));
});
const showcaseItems = showcasePhotos.slice(0, 5).map((item, index) => ({ ...item, index }));
---

<BaseLayout
  title="Ірина Тимоніна — фотографиня"
  description="Весільна та сімейна фотозйомка. Живі, теплі фотографії про людей і головні моменти їхнього життя."
  transparentHeader
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.titleLine1}<br /><em>{site.hero.titleEmphasis}</em> {site.hero.titleLine2}</h1>
      <p class="hero-description">{site.hero.description}</p>
      <a class="cta" href="#contacts">записатися на зйомку</a>
    </div>
    {heroPhoto && (
      <div class="hero-image-wrap">
        <Image src={heroPhoto} alt={site.heroPhotoAlt} widths={[600, 1200]} sizes="(max-width: 1023px) 100vw, 57vw" />
        <span class="hero-caption">{site.heroCaption}</span>
      </div>
    )}
  </section>

  {showcaseItems.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">вибране</p>
        <h2>Історії, які<br /><em>залишаються</em></h2>
      </div>
      <div class="showcase-grid">
        {showcaseItems.map(({ photo, slug, index }) => (
          <a
            href={`/portfolio/${slug}`}
            class={`showcase-item ${index === 0 ? 'showcase-tall' : ''}`}
          >
            <Image src={photo.image} alt={photo.alt} widths={[400, 800]} sizes="(max-width: 768px) 50vw, 33vw" />
          </a>
        ))}
      </div>
      <a class="text-link" href="/portfolio">усе портфоліо</a>
    </section>
  )}

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">категорії</p>
      <h2>Оберіть<br /><em>зйомку</em></h2>
    </div>
    <div class="grid">
      {galleries.map((gallery) => (
        <CategoryCard
          href={`/portfolio/${gallery.data.slug}`}
          title={gallery.data.title}
          cover={getCoverImage(gallery.data.slug, gallery.data.cover)}
        />
      ))}
    </div>
  </section>

  <section class="section about">
    <div class="about-image">
      {aboutPhoto && <Image src={aboutPhoto} alt="Ірина Тимоніна за роботою" />}
    </div>
    <div class="about-copy">
      <p class="eyebrow">{site.about.eyebrow}</p>
      <h2>Привіт, я<br /><em>{site.about.titleEmphasis}</em></h2>
      {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="contact-section" id="contacts">
    <p class="eyebrow">давайте створимо щось красиве</p>
    <h2>Ваша історія<br /><em>починається тут</em></h2>
    <a class="contact-cta" href={site.contacts.telegram} rel="noopener noreferrer">
      написати в Telegram
    </a>
  </section>
</BaseLayout>
