---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  cover?: ImageMetadata;
}

const { href, title, cover } = Astro.props;
---

<a href={href} class="card" data-testid="category-card">
  {cover && (
    <Image
      src={cover}
      alt={`Обкладинка категорії «${title}»`}
      widths={[400, 800]}
      sizes="(max-width: 600px) 100vw, 400px"
    />
  )}
  <span class="card__title">{title}</span>
</a>
