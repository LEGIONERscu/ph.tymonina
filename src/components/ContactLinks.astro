---
// Контакти редагуються через адмінку (/admin → "Загальні налаштування") — src/content/site.json.
import site from '../content/site.json';

const contacts = [
  { label: 'Telegram', href: site.contacts.telegram },
  { label: 'Viber', href: site.contacts.viber },
  { label: 'Instagram', href: site.contacts.instagram },
  { label: 'Телефон', href: site.contacts.phone },
];
---

<ul class="contact-links" data-testid="contact-links">
  {contacts.map((c) => (
    <li>
      <a href={c.href} rel="noopener noreferrer">{c.label}</a>
    </li>
  ))}
</ul>
