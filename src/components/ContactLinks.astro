---
// Контакти редагуються через адмінку (/admin → "Загальні налаштування") — src/content/site.json.
import site from '../content/site.json';

const contacts = [
  { label: 'Telegram', href: site.contacts.telegram, icon: 'telegram' },
  { label: 'Viber', href: site.contacts.viber, icon: 'viber' },
  { label: 'Instagram', href: site.contacts.instagram, icon: 'instagram' },
  { label: 'Телефон', href: site.contacts.phone, icon: 'phone' },
] as const;
---

<ul class="contact-links" data-testid="contact-links">
  {contacts.map((c) => (
    <li>
      <a href={c.href} rel="noopener noreferrer" aria-label={c.label} title={c.label}>
        {c.icon === 'telegram' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
          </svg>
        )}
        {c.icon === 'viber' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
        )}
        {c.icon === 'instagram' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8a4 4 0 0 1 3.37 3.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
        )}
        {c.icon === 'phone' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>
